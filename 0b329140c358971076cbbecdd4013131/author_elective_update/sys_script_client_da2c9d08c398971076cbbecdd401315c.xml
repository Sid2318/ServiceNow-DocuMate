        <messages/>
        <name>Load Source Path Choices</name>
        <order/>
        <script><![CDATA[function onLoad() {
    loadSourcePathChoices();
}

function loadSourcePathChoices() {
    var templateSysId = g_form.getValue('template');
    var currentSourcePath = g_form.getValue('source_path');

    g_form.clearOptions('source_path');
    g_form.addOption('source_path', '', '-- None --');

    if (!templateSysId)
        return;

    var ga = new GlideAjax('DocuMateFieldAjax');
    ga.addParam('sysparm_name', 'getFieldsForTemplate');
    ga.addParam('sysparm_template', templateSysId);

    ga.getXMLAnswer(function(answer) {
        var fields = [];

        try {
            fields = JSON.parse(answer || '[]');
        } catch (e) {
            fields = [];
        }

        var currentValueExists = false;

        for (var i = 0; i < fields.length; i++) {
            g_form.addOption('source_path', fields[i].value, fields[i].label);

            if (fields[i].value === currentSourcePath)
                currentValueExists = true;
        }

        // If existing value is a dot-walk like caller_id.email, keep it visible
        if (currentSourcePath && !currentValueExists) {
            g_form.addOption(
                'source_path',
                currentSourcePath,
                currentSourcePath + ' [current value]'
            );
        }

        if (currentSourcePath)
            g_form.setValue('source_path', currentSourcePath);
    });
}]]></script>
