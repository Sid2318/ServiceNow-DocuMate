        <name>Generate Test Document</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeAction(current, action) {

    try {
        var sourceTable = current.getValue('table');
        var testRecordSysId = current.getValue('test_record_sys_id');

        if (!sourceTable) {
            gs.addErrorMessage('Source Table is empty on the template.');
            action.setRedirectURL(current);
            return;
        }

        if (!testRecordSysId) {
            gs.addErrorMessage('Test Record Sys ID is empty on the template.');
            action.setRedirectURL(current);
            return;
        }

        var sourceRecord = new GlideRecord(sourceTable);

        if (!sourceRecord.isValid()) {
            gs.addErrorMessage('Invalid source table: ' + sourceTable);
            action.setRedirectURL(current);
            return;
        }

        if (!sourceRecord.get(testRecordSysId)) {
            gs.addErrorMessage('Test record not found in table ' + sourceTable + ': ' + testRecordSysId);
            action.setRedirectURL(current);
            return;
        }

        var flow = new x_2162040_documate.TemplateFlow();
        var result = flow.generateTestDocument(current);

        if (result.success) {
            gs.addInfoMessage(result.message);
        } else {
            gs.addErrorMessage(result.message);
        }

        action.setRedirectURL(current);

    } catch (ex) {
        gs.addErrorMessage('Unexpected error while generating document: ' + ex.toString());
        action.setRedirectURL(current);
    }

})(current, action);]]></script>
