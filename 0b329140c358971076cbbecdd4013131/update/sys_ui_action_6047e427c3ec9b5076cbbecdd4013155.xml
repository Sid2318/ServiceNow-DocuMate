        <script><![CDATA[function openPreview() {
    var ga = new GlideAjax('PreviewDoc');
    ga.addParam('sysparm_name', 'preview');
    ga.addParam('sysparm_template', g_form.getUniqueValue());
    ga.addParam('sysparm_record', g_form.getValue('test_record_sys_id'));
    ga.addParam('sysparm_html', g_form.getValue('html_template'));
    ga.getXMLAnswer(function(a) {
        var r = JSON.parse(a);
        if (!r.success) { g_form.addErrorMessage(r.message); return; }
        var w = new GlideModal('preview_modal', false, 900);
        w.setTitle('Preview (sample record, not saved)');
        w.renderWithContent('<iframe style="width:100%;height:600px;border:0" srcdoc="' +
            r.html.replace(/&/g,'&amp;').replace(/"/g,'&quot;') + '"></iframe>');
    });
}]]></script>
